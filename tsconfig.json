{
  "compilerOptions": {
    /* Base Options */
    "target": "ESNext" /* Latest ECMAScript features */,
    "module": "nodenext" /* Standard for Node.js scripts */,
    "moduleResolution": "nodenext" /* Resolve modules like Node.js does */,
    "outDir": "./dist" /* Where compiled JS goes */,
    "rootDir": "./" /* Where your TS files live */,

    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@root/*": ["./*"]
    },

    /* Strictness & Safety */
    "strict": true /* Enable all strict type-checking */,
    "noImplicitAny": true /* Error on expressions with implied 'any' */,
    "esModuleInterop": true /* Allows 'import' instead of 'require' for CommonJS */,
    "skipLibCheck": true /* Skip type checking of declaration files (.d.ts) */,
    "forceConsistentCasingInFileNames": true /* Ensure imports match file casing */,

    /* Environment */
    "types": [
      "node",
      "vitest/globals"
    ] /* Explicitly include Node types for 'process' */
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "vitest.config.ts"
  ] /* Compile everything in src, test and vitest file*/,
  "exclude": [
    "node_modules",
    "dist"
    // "**/*.test.ts"
  ]
}
