{
  "name": "ledgerly-export-service",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "imports": {
    "#/*": {
      "types": "./src/*",
      "default": "./dist/src/*"
    }
  },
  "scripts": {
    "generate-types": "openapi-typescript ./shared-schema/openapi.yaml -o ./types.ts",
    "sync-schema": "git -C ./shared-schema pull && npm run generate-types",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npx tsc",
    "parse:custom:local": "node  --env-file=configuration/.env.local dist/src/parseAppleNotesIndex.js",
    "export:custom:local": "node  --env-file=configuration/.env.local dist/src/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@notionhq/client": "^5.13.0",
    "openapi-typescript": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  }
}
